Options -Indexes
ServerSignature Off

ErrorDocument 404 /public/404.php

# Block access to sensitive directories
<FilesMatch "\.(sql|log|md|json|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Webhook (WhatsApp - must be accessible)
    RewriteRule ^webhook/?$ public/webhook.php [L]

    # Archivos SEO en raíz
    RewriteRule ^sitemap\.xml$ public/sitemap.xml [L]
    RewriteRule ^robots\.txt$  public/robots.txt  [L]

    # Blog
    RewriteRule ^blog/?$ public/blog.php [L]

    # Propuestas
    RewriteRule ^propuesta/?$ public/propuesta.php [L]
    RewriteRule ^propuesta/([A-Z0-9\-]+)/?$ public/propuesta.php?c=$1 [QSA,L]

    # Block access to app/ and views/
    RewriteRule ^app/     - [F,L]
    RewriteRule ^views/   - [F,L]
    RewriteRule ^logs/    - [F,L]

    # ✅ Allow webhook.php to be accessed directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^public/webhook\.php$ - [L]

    # Allow other .php files to be accessed directly
    RewriteCond %{REQUEST_FILENAME} \.php$ [NC]
    RewriteRule ^ - [L]

    # Clean URLs for public pages
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://graph.facebook.com https://dolarapi.com; frame-ancestors 'none'; object-src 'none'"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg           "access plus 1 year"
    ExpiresByType image/png            "access plus 1 year"
    ExpiresByType image/webp           "access plus 1 year"
</IfModule>
